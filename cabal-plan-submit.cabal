cabal-version:      3.0
name:               cabal-plan-submit
version:            0.1.0.9
build-type:         Simple
license:            MIT
license-file:       LICENSE
synopsis:            Haskell dependency intelligence for supply-chain security
description:
  cabal-plan-submit reads Cabal's resolved plan.json and helps make
  dependency/security reports actionable. It can submit dependency snapshots
  to GitHub Dependency Graph, explain dependency paths, inspect deprecated
  Hackage packages, and enrich cabal-audit SARIF output.
category:            Distribution, Security
maintainer:          Piotr Paradzinski <piotr.paradzinski@gmail.com>
homepage:            https://github.com/dancewithheart/cabal-plan-submit
bug-reports:         https://github.com/dancewithheart/cabal-plan-submit/issues
extra-doc-files:     README.md
                   , CHANGELOG.md

source-repository head
  type: git
  location: https://github.com/dancewithheart/cabal-plan-submit.git

executable cabal-plan-submit
  main-is:          Main.hs
  hs-source-dirs:   app, src
  default-language: GHC2021
  other-modules:
    Hgs.Deprecated
    Hgs.Domain
    Hgs.Sarif.Deprecated
    Hgs.Sarif.Enrich
    Hgs.Extract
    Hgs.Locals
    Hgs.LocalUnitFilter
    Hgs.Snapshot
    Hgs.Validate
    Hgs.Input.PlanJson
    Hgs.Why
    Paths_cabal_plan_submit
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints
  build-depends:
      base            >=4.16 && <5
    , aeson
    , bytestring
    , containers
    , directory
    , filepath
    , text
    , time
    , vector
    , yaml

test-suite plan-json-test
  type:             exitcode-stdio-1.0
  main-is:          Tests.hs
  hs-source-dirs:   test, src
  other-modules:
      Hgs.Deprecated
      Hgs.Domain
      Hgs.Extract
      Hgs.Input.PlanJson
      Hgs.Locals
      Hgs.LocalUnitFilter
      Hgs.Sarif.Enrich
      Hgs.Snapshot
      Hgs.Validate
      Hgs.Why
      GoldenSpec
      DeprecatedSpec
      LocalsSpec
      PlanJsonSpec
      SnapshotSpec
      SarifEnrichSpec
      TestSupport
  extra-source-files:
    test/golden/deprecated.yaml
    test/golden/unix-time/plan.json
    test/golden/unix-time/inspect-deprecated-production.golden
    test/golden/persistent/plan.json
    test/golden/persistent/sarif.json
    test/golden/persistent/enrich-sarif.golden
  default-language: GHC2021
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints
  build-depends:
      base            >=4.16 && <5
    , aeson
    , bytestring
    , containers
    , directory
    , hspec
    , filepath
    , QuickCheck
    , text
    , time
    , vector
    , yaml
